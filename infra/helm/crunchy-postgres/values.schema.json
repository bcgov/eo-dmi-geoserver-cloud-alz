{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "crunchy"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "required": ["dbName"],
          "properties": {
            "dbName": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "crunchy": {
      "type": "object",
      "required": [
        "enabled",
        "postgresVersion",
        "postGISVersion",
        "image",
        "instances",
        "pgBackRest",
        "patroni",
        "proxy",
        "pgmonitor",
        "users"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "postgresVersion": { "type": "integer", "minimum": 12 },
        "postGISVersion": { "type": "string", "minLength": 1 },
        "image": {
          "type": "string",
          "pattern": "^artifacts\\.developer\\.gov\\.bc\\.ca/bcgov-docker-local/[a-z0-9][a-z0-9._/-]*(:[^:\\s]+|@sha256:[a-f0-9]{64})$"
        },
        "instances": {
          "type": "object",
          "required": [
            "name",
            "replicas",
            "dataVolumeClaimSpec",
            "requests",
            "replicaCertCopy"
          ],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "replicas": { "type": "integer", "minimum": 1 },
            "dataVolumeClaimSpec": {
              "type": "object",
              "required": ["storage", "walStorage", "storageClassName"],
              "properties": {
                "storage": { "$ref": "#/definitions/storageQuantity" },
                "walStorage": { "$ref": "#/definitions/storageQuantity" },
                "storageClassName": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            },
            "requests": { "$ref": "#/definitions/cpuMemory" },
            "replicaCertCopy": { "$ref": "#/definitions/resources" }
          },
          "additionalProperties": true
        },
        "pgBackRest": { "type": "object", "minProperties": 1 },
        "users": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests"],
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemory" }
      },
      "additionalProperties": true
    },
    "cpuMemory": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "storageQuantity": {
      "type": "string",
      "pattern": "^(?:(?:[1-9][0-9]{0,2}|10[0-1][0-9]|102[0-3]|1024)Mi|1Gi)$"
    }
  },
  "additionalProperties": true
}
