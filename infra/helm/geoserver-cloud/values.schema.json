{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "images",
    "services",
    "database",
    "rabbitmq",
    "proxy",
    "secrets",
    "initDatabase"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": ["imagePullSecrets", "artifactory"],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "artifactory": {
          "type": "object",
          "required": ["registry", "dockerHubRepository", "localRepository"],
          "properties": {
            "registry": { "const": "artifacts.developer.gov.bc.ca" },
            "dockerHubRepository": { "type": "string", "minLength": 1 },
            "localRepository": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "images": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "tag"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9._-]*)*$"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
            "not": { "const": "latest" }
          },
          "repository": { "type": "string", "enum": ["dockerHub", "local"] },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "serviceDefaults": { "$ref": "#/definitions/serviceConfig" },
    "services": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": { "$ref": "#/definitions/serviceOverride" }
    },
    "proxy": { "$ref": "#/definitions/proxy" },
    "database": {
      "type": "object",
      "required": ["crunchyReleaseName", "crunchyUserName", "schema"],
      "properties": {
        "crunchyReleaseName": { "type": "string", "minLength": 1 },
        "crunchyUserName": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rabbitmq": { "$ref": "#/definitions/rabbitmq" },
    "secrets": { "$ref": "#/definitions/secrets" },
    "initDatabase": { "$ref": "#/definitions/initDatabase" }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests"],
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemory" }
      },
      "additionalProperties": false
    },
    "cpuMemory": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scaleBehavior": {
      "type": "object",
      "required": ["stabilizationWindowSeconds", "policies"],
      "properties": {
        "stabilizationWindowSeconds": { "type": "integer", "minimum": 0 },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "value", "periodSeconds"],
            "properties": {
              "type": { "type": "string", "enum": ["Pods", "Percent"] },
              "value": { "type": "integer", "minimum": 1 },
              "periodSeconds": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "behavior"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "behavior": {
          "type": "object",
          "required": ["scaleUp", "scaleDown"],
          "properties": {
            "scaleUp": { "$ref": "#/definitions/scaleBehavior" },
            "scaleDown": { "$ref": "#/definitions/scaleBehavior" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": [
        "path",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      },
      "additionalProperties": false
    },
    "serviceConfig": {
      "type": "object",
      "required": [
        "port",
        "replicas",
        "terminationGracePeriodSeconds",
        "resources",
        "autoscaling",
        "probes",
        "extraEnv"
      ],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "probes": { "$ref": "#/definitions/probes" },
        "extraEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "serviceOverride": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "probes": { "$ref": "#/definitions/probes" },
        "extraEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "required": [
        "enabled",
        "serviceName",
        "port",
        "replicas",
        "terminationGracePeriodSeconds",
        "resources",
        "autoscaling",
        "probes",
        "gatewayOrigin",
        "publicOrigin",
        "route",
        "oidc",
        "session",
        "identity",
        "machineAuthPassthrough",
        "defaultReturnTo",
        "gatewayTlsInsecure",
        "gatewayConnectTimeoutMs",
        "gatewayReadTimeoutMs",
        "logLevel",
        "debugHeaders",
        "debugUnsafeHeaders",
        "geoserver",
        "extraEnv"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceName": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "probes": { "$ref": "#/definitions/probes" },
        "gatewayOrigin": { "type": "string" },
        "publicOrigin": { "type": "string" },
        "route": {
          "type": "object",
          "required": ["enabled", "host", "tls"],
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "tls": {
              "type": "object",
              "required": ["termination", "insecureEdgeTerminationPolicy"],
              "properties": {
                "termination": {
                  "type": "string",
                  "enum": ["edge", "passthrough", "reencrypt"]
                },
                "insecureEdgeTerminationPolicy": {
                  "type": "string",
                  "enum": ["Allow", "Redirect", "None"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "oidc": {
          "type": "object",
          "required": ["issuer", "clientId", "scopes"],
          "properties": {
            "issuer": { "type": "string" },
            "clientId": { "type": "string" },
            "scopes": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "required": ["cookieName", "maxAgeSeconds"],
          "properties": {
            "cookieName": { "type": "string", "minLength": 1 },
            "maxAgeSeconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "required": [
            "identityHeader",
            "rolesHeader",
            "oidcRoles",
            "usernameClaim",
            "usernameLowercase",
            "userGuidClaim",
            "displayNameHeader",
            "displayNameClaim"
          ],
          "properties": {
            "identityHeader": { "type": "string", "minLength": 1 },
            "rolesHeader": { "type": "string", "minLength": 1 },
            "oidcRoles": { "type": "string", "minLength": 1 },
            "usernameClaim": { "type": "string", "minLength": 1 },
            "usernameLowercase": { "type": "boolean" },
            "userGuidClaim": { "type": "string", "minLength": 1 },
            "displayNameHeader": { "type": "string", "minLength": 1 },
            "displayNameClaim": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "machineAuthPassthrough": { "type": "boolean" },
        "defaultReturnTo": { "type": "string", "minLength": 1 },
        "gatewayTlsInsecure": { "type": "boolean" },
        "gatewayConnectTimeoutMs": { "type": "integer", "minimum": 1 },
        "gatewayReadTimeoutMs": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string", "minLength": 1 },
        "debugHeaders": { "type": "boolean" },
        "debugUnsafeHeaders": { "type": "boolean" },
        "geoserver": {
          "type": "object",
          "required": ["basePath", "userGroupService", "adminPrincipals"],
          "properties": {
            "basePath": { "type": "string", "minLength": 1 },
            "userGroupService": { "type": "string", "minLength": 1 },
            "adminPrincipals": { "type": "string" }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "rabbitmq": {
      "type": "object",
      "required": [
        "serviceName",
        "port",
        "replicas",
        "resources",
        "storage",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "serviceName": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "resources": { "$ref": "#/definitions/resources" },
        "storage": {
          "type": "object",
          "required": ["size", "storageClassName"],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^(?:(?:[1-9][0-9]{0,2}|10[0-1][0-9]|102[0-3]|1024)Mi|1Gi)$"
            },
            "storageClassName": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["name", "keys"],
          "properties": {
            "name": { "type": "string" },
            "oidcClientSecret": { "type": "string", "minLength": 1 },
            "keys": {
              "type": "object",
              "required": [
                "rabbitmqUsername",
                "rabbitmqPassword",
                "geoserverAdminUsername",
                "geoserverAdminPassword",
                "aclAdminPassword",
                "aclGeoserverPassword",
                "aclGeoserverPasswordPlain",
                "oidcClientSecret",
                "sessionCookieSecret",
                "rabbitmqErlangCookie"
              ],
              "properties": {
                "rabbitmqUsername": { "type": "string", "minLength": 1 },
                "rabbitmqPassword": { "type": "string", "minLength": 1 },
                "geoserverAdminUsername": { "type": "string", "minLength": 1 },
                "geoserverAdminPassword": { "type": "string", "minLength": 1 },
                "aclAdminPassword": { "type": "string", "minLength": 1 },
                "aclGeoserverPassword": { "type": "string", "minLength": 1 },
                "aclGeoserverPasswordPlain": {
                  "type": "string",
                  "minLength": 1
                },
                "oidcClientSecret": { "type": "string", "minLength": 1 },
                "sessionCookieSecret": { "type": "string", "minLength": 1 },
                "rabbitmqErlangCookie": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "initDatabase": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "backoffLimit",
        "activeDeadlineSeconds",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1200 },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
